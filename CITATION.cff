    given-names: Andrew D.
    orcid: "https://orcid.org/0000-0002-0745-2075"
license: GPL-3.0-or-later
repository-code: "https://github.com/MNiMORPH/artesian"
keywords:
  - pyodide
  - webassembly
  - science communication
  - numerical modeling
